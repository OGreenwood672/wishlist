# Generate these two with:  npm run setup-secrets -- "your-admin-password"
APP_SECRET=
ADMIN_PASSWORD_HASH=

# Added automatically by the Vercel <> Supabase integration.
# For local dev, copy them from Supabase → Project Settings → API (or run `vercel env pull`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables AI-generated themes. Without it, themes come from presets.
ANTHROPIC_API_KEY=
